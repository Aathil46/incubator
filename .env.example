# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# SUPABASE_URL: Your Supabase project URL (Server-side only)
SUPABASE_URL="https://your-project-id.supabase.co"

# SUPABASE_ANON_KEY: Your Supabase anon/public key
SUPABASE_ANON_KEY="your-supabase-anon-key"

# SUPABASE_SERVICE_ROLE_KEY: Your Supabase service_role secret key (NEVER expose to frontend)
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"

# SESSION_SECRET: Secret string used to sign HTTP-only authentication session cookies
SESSION_SECRET="replace-with-a-random-64-char-secret"

# One-time first-administrator bootstrap credentials
BOOTSTRAP_ADMIN_EMPLOYEE_ID="ADM-001"
BOOTSTRAP_ADMIN_FULL_NAME="System Administrator"
BOOTSTRAP_ADMIN_PASSWORD="replace-with-a-random-12-plus-character-password"
